# Set these in Coolify -> your resource -> Environment Variables.
# SERVICE_PASSWORD_DB, SERVICE_PASSWORD_ADMIN and the domain are generated by Coolify.

# Hostname of the ERP (DNS A record must point at the VPS), e.g. erp.drkathiravan.uk
SITE_NAME=erp.example.com

# Image tag built by GitHub Actions (v15 always = latest build). Pin e.g. v15-20261121 for stability.
IMAGE_TAG=v15

# Days of backups kept inside the server
BACKUP_KEEP_DAYS=14
